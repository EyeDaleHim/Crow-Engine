{
    "asyncLoading": true,
    "logic": {
        "initialState": {
            "bgColor": "0xFF9933"
        },
        "listeners": [
            {
                "event": "create",
                "weak": true,
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "check_songs"
                        }
                    }
                ]
            },
            {
                "event": "transitionInFinished",
                "weak": true,
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "check_songs"
                        }
                    }
                ]
            },
            {
                "event": "check_songs",
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "songs_notempty"
                        }
                    },
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "songs_empty"
                        }
                    }
                ]
            },
            {
                "event": "songs_notempty",
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "check_empty",
                            "actions": {
                                "show": false
                            }
                        }
                    }
                ],
                "condition": {
                    "type": "CHECK",
                    "stateKey": "songListLength",
                    "operatorCode": "NEQ",
                    "targetValues": [
                        0
                    ]
                }
            },
            {
                "event": "songs_empty",
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "check_empty",
                            "actions": {
                                "show": true
                            }
                        }
                    }
                ],
                "condition": {
                    "type": "CHECK",
                    "stateKey": "songListLength",
                    "operatorCode": "EQ",
                    "targetValues": [
                        0
                    ]
                }
            }
        ]
    },
    "layouts": [
        {
            "name": "main",
            "type": "DYNAMIC",
            "direction": "VERTICAL",
            "selectionMode": "WRAP",
            "position": {
                "x": 80,
                "y": 0
            },
            "gap": 120,
            "centerOnSelection": true,
            "lerpSpeed": 8.0,
            "xOffset": 20.0
        }
    ],
    "elements": [
        {
            "name": "bg",
            "entity": "menu/color_background",
            "screenCenter": {
                "x": true,
                "y": true
            }
        },
        {
            "name": "_root_layout",
            "layout": "song_list"
        },
        {
            "dataSource": "GROUPS",
            "entity": "generic/scroll_text_capsule",
            "listeners": [
                {
                    "event": "create",
                    "actions": [
                        {
                            "type": "set_text",
                            "values": {
                                "text": "${displayName}"
                            }
                        }
                    ]
                },
                {
                    "event": "accept",
                    "actions": [
                        {
                            "type": "switch_scene",
                            "values": {
                                "scene": "gameplay",
                                "levelId": "${id}"
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "inputActions": [
        {
            "input": "back",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "return_to_previous_scene"
                }
            ]
        },
        {
            "input": "ui_up",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "navigate",
                    "values": {
                        "direction": -1,
                        "layout": "main"
                    }
                },
                {
                    "type": "play_sound",
                    "values": {
                        "sound": "sfx/navigate/scroll",
                        "volume": 0.6
                    }
                }
            ]
        },
        {
            "input": "ui_up",
            "check": "repeated",
            "advanced": {
                "repeatStart": 0.25,
                "repeatRate": 0.1,
                "pauseOnOthers": ["ui_down"]
            },
            "actions": [
                {
                    "type": "navigate",
                    "values": {
                        "direction": -1,
                        "layout": "main"
                    }
                },
                {
                    "type": "play_sound",
                    "values": {
                        "sound": "sfx/navigate/scroll",
                        "volume": 0.6
                    }
                }
            ]
        },
        {
            "input": "ui_down",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "navigate",
                    "values": {
                        "direction": 1,
                        "layout": "main"
                    }
                },
                {
                    "type": "play_sound",
                    "values": {
                        "sound": "sfx/navigate/scroll",
                        "volume": 0.6
                    }
                }
            ]
        },
        {
            "input": "ui_down",
            "check": "repeated",
            "advanced": {
                "repeatStart": 0.25,
                "repeatRate": 0.1,
                "pauseOnOthers": ["ui_up"]
            },
            "actions": [
                {
                    "type": "navigate",
                    "values": {
                        "direction": 1,
                        "layout": "main"
                    }
                },
                {
                    "type": "play_sound",
                    "values": {
                        "sound": "sfx/navigate/scroll",
                        "volume": 0.6
                    }
                }
            ]
        }
    ]
}