{
    "logic": {
        "initialState": {
            "bgColor": "0xFF9933"
        },
        "listeners": [
            {
                "event": "create",
                "weak": true,
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "check_songs"
                        }
                    }
                ]
            },
            {
                "event": "transitionInFinished",
                "weak": true,
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "check_songs"
                        }
                    }
                ]
            },
            {
                "event": "check_songs",
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "songs_notempty"
                        }
                    },
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "songs_empty"
                        }
                    }
                ]
            },
            {
                "event": "songs_notempty",
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "check_empty",
                            "actions": {
                                "show": true
                            }
                        }
                    }
                ],
                "condition": {
                    "type": "CHECK",
                    "stateKey": "songListLength",
                    "scope": "global",
                    "operatorCode": "NEQ",
                    "targetValues": [
                        0
                    ]
                }
            },
            {
                "event": "songs_empty",
                "actions": [
                    {
                        "type": "dispatch_event",
                        "values": {
                            "name": "check_empty",
                            "actions": {
                                "show": false
                            }
                        }
                    }
                ],
                "condition": {
                    "type": "CHECK",
                    "stateKey": "songListLength",
                    "scope": "global",
                    "operatorCode": "EQ",
                    "targetValues": [
                        0
                    ]
                }
            }
        ]
    },
    "layouts": [
        {
            "name": "song_list",
            "direction": "VERTICAL",
            "gap": 15,
            "alignItems": "CENTER",
            "selectionMode": "BOUND"
        }
    ],
    "elements": [
        {
            "name": "bg",
            "entity": "menu/color_background",
            "screenCenter": {
                "x": true,
                "y": true
            }
        },
        {
            "name": "_root_layout",
            "layout": "song_list",
            "position": {
                "x": 0,
                "y": 100
            }
        },
        {
            "dataSource": "GROUPS",
            "entity": "generic/scroll_text_capsule",
            "listeners": [
                {
                    "event": "create",
                    "actions": [
                        {
                            "type": "set_text",
                            "values": {
                                "text": "${displayName}"
                            }
                        }
                    ]
                },
                {
                    "event": "accept",
                    "actions": [
                        {
                            "type": "switch_scene",
                            "values": {
                                "scene": "gameplay",
                                "levelId": "${id}"
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "inputActions": [
        {
            "input": "back",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "return_to_previous_scene"
                }
            ]
        }
    ]
}