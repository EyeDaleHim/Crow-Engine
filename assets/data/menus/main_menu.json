    "inputActions": [
        {
            "input": "back",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "return_to_previous_scene"
                }
            ]
        },
        {
            "input": "accept",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "accept_selection",
                    "values": {
