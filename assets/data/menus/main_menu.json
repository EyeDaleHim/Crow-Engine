{
    "asyncLoading": true,
    "layouts": [
        {
            "name": "main",
            "selectionMode": "WRAP",
            "gap": 16.0,
            "alignItems": "CENTER"
        }
    ],
    "logic": {
        "initialState": {
            "action_pressed": false
        },
        "listeners": [
            {
                "event": "create",
                "weak": true,
                "actions": [
                    {
                        "type": "navigate",
                        "values": {
                            "direction": 0,
                            "layout": "main"
                        }
                    }
                ]
            }
        ]
    },
    "genericElements": [
        {
            "name": "main_menu_item",
            "menuItem": {
                "listeners": [
                    {
                        "event": "accept",
                        "actions": [
							{
								"type": "switch_scene",
								"values": {
									"scene": "freeplay"
								}
							}
                        ]
                    },
                    {
                        "event": "select",
                        "actions": [
                            { "type": "play_animation", "values": { "anim": "selected", "force": true } }
                        ]
                    },
                    {
                        "event": "deselect",
                        "actions": [
                            { "type": "play_animation", "values": { "anim": "idle", "force": true } }
                        ]
                    }
                ],
                "overrideData": {
                    "layoutTarget": { "width": 300, "height": 130, "relativeToCenter": { "x": true, "y": true } }
                }
            }
        }
    ],
    "elements": [
        {
            "name": "background",
            "entity": "menu/background",
            "screenCenter": {
                "x": true,
                "y": true
            }
        },
        {
            "name": "_root_layout",
            "screenCenter": {
                "x": true,
                "y": true
            }
        },
        {
            "genericReference": "main_menu_item",
            "entity": "menu/story_mode"
        },
        {
            "genericReference": "main_menu_item",
            "entity": "menu/freeplay"
        },
        {
            "genericReference": "main_menu_item",
            "entity": "menu/credits"
        },
        {
            "genericReference": "main_menu_item",
            "entity": "menu/options"
        }
    ],
    "inputActions": [
        {
            "input": "back",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "return_to_previous_scene"
                }
            ]
        },
        {
            "input": "accept",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "accept_selection",
                    "values": {
                        "layout": "main"
                    }
                }
            ]
        },
        {
            "input": "back",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "return_to_previous_scene"
                }
            ]
        },
        {
            "input": "ui_up",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "navigate",
                    "values": {
                        "direction": -1,
                        "layout": "main"
                    }
                },
                {
                    "type": "play_sound",
                    "values": {
                        "sound": "sfx/navigate/scroll",
                        "volume": 0.6
                    }
                }
            ]
        },
        {
            "input": "ui_down",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "navigate",
                    "values": {
                        "direction": 1,
                        "layout": "main"
                    }
                },
                {
                    "type": "play_sound",
                    "values": {
                        "sound": "sfx/navigate/scroll",
                        "volume": 0.6
                    }
                }
            ]
        }
    ]
}