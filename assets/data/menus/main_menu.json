                    }
                }
            ]
        },
        {
            "input": "back",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "return_to_previous_scene"
                }
            ]
        },
        {
            "input": "ui_up",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "navigate",
                    "values": {
                        "direction": -1,
                        "layout": "main"
                    }
                },
                {
                    "type": "play_sound",
                    "values": {
                        "sound": "sfx/navigate/scroll",
                        "volume": 0.6
                    }
                }
            ]
        },
        {
            "input": "ui_down",
            "check": "just_pressed",
            "actions": [
                {
                    "type": "navigate",
                    "values": {
                        "direction": 1,
                        "layout": "main"
                    }
                },
                {
                    "type": "play_sound",
