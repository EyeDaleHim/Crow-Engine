{
	"search.exclude": {
		"export/**/*.*": true
	},
	"[haxe]": {
		"editor.formatOnSaveMode": "modifications",
		"editor.formatOnPaste": false
	},
	"haxe.enableExtendedIndentation": true,
	"files.associations": {
		"*.hxp": "haxe",
		"*.hscript": "haxe",
		"*.haxe": "haxe",
		"*.hxs": "haxe",
		"*.hxc": "haxe",
		"*.json": "jsonc"
	},
	"search.useIgnoreFiles": true,
}